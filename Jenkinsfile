// =====================================================================
// CBS Spring Boot backend — Jenkins pipeline (Multibranch, source: gitlab.com)
// ---------------------------------------------------------------------
//  feature/*, bugfix/*  →  Secret scan → Build & Test                  (fast feedback)
//  uat                  →  … → Image (amd64+arm64) → TRIVY GATE → AUTO deploy to cbs-uat
//  main                 →  … → Image → TRIVY GATE → APPROVAL → deploy to cbs-prod
//
//  Build with Parameters → SECRETS_ONLY = re-apply the env credential and restart
//  the pods with the SAME image (use after changing a password in Jenkins).
//
//  Agents: Pods on the K3s "k8" node (ci/jenkins-agent-pod.yaml), created per build.
//  Controller: Jenkins on pi5, installed by Terraform-Plan playbooks/install/jenkins.yml
//
//  Jenkins credentials used (Manage Jenkins → Credentials → System → Global):
//    gitlab-repo           Username+Password  GitLab user + PAT (read_repository)  – job source
//    gitlab-registry-push  Username+Password  GitLab deploy token (read+write_registry)
//    gitlab-registry-pull  Username+Password  GitLab deploy token (read_registry)  – cluster pulls
//    cbs-uat-env           Secret file        app secrets for UAT  (deploy/cbs.env.example)
//    cbs-prod-env          Secret file        app secrets for PROD
//    kubeconfig-cbs-uat    Secret file        generated by jenkins.yml (namespace cbs-uat only)
//    kubeconfig-cbs-prod   Secret file        generated by jenkins.yml (namespace cbs-prod only)
//
//  CHANGE the values marked CHANGE in `environment` before first use.
// =====================================================================

pipeline {
    // No global agent: the approval stage must NOT hold an agent Pod
    // while it waits (possibly hours) for a human.
    agent none

    parameters {
        booleanParam(name: 'SECRETS_ONLY', defaultValue: false,
            description: 'Skip build. Re-apply cbs-<env>-env to the cluster and restart pods with the current image (uat: immediately, main: after approval).')
    }

    options {
        timestamps()
        disableConcurrentBuilds()                     // one build per branch at a time
        buildDiscarder(logRotator(numToKeepStr: '30'))
    }

    environment {
        REGISTRY        = 'registry.gitlab.com'
        // CHANGE: registry.gitlab.com/<namespace>/<project>, ALL LOWERCASE
        IMAGE_NAME      = 'registry.gitlab.com/bunlongchea/springboot-core-banking'
        PLATFORMS       = 'linux/amd64,linux/arm64'   // pi5 = arm64, k8 = amd64
        KUBECTL_VERSION = 'v1.36.4'                   // match k3s_version in Terraform-Plan versions.yml
        // Trivy gate: fail on HIGH/CRITICAL that have a fix available
        TRIVY_SEVERITY  = 'HIGH,CRITICAL'
        // Who may click "Approve & Deploy": comma-separated Jenkins user IDs  CHANGE
        PROD_APPROVERS  = 'admin'
    }

    stages {

        // -------------------------------------------------------------
        // CI — every branch (skipped when SECRETS_ONLY)
        // -------------------------------------------------------------
        stage('CI') {
            when {
                beforeAgent true
                expression { !params.SECRETS_ONLY }
            }
            agent {
                kubernetes {
                    yamlFile 'ci/jenkins-agent-pod.yaml'
                    defaultContainer 'maven'
                }
            }
            stages {

                stage('Prepare') {
                    steps {
                        script {
                            def shortSha   = sh(script: 'git rev-parse --short=8 HEAD', returnStdout: true).trim()
                            def safeBranch = env.BRANCH_NAME.replaceAll('[^a-zA-Z0-9_.-]', '-')
                            // e.g. uat-42-1a2b3c4d  /  main-17-9f8e7d6c
                            env.IMAGE_TAG = "${safeBranch}-${env.BUILD_NUMBER}-${shortSha}"
                            env.GIT_SHA   = shortSha
                            currentBuild.displayName = "#${env.BUILD_NUMBER} ${env.IMAGE_TAG}"
                        }
                        sh 'java -version'
                    }
                }

                stage('Secret Scan') {
                    // Fails the build if a password/key/token is committed
                    // (this would have caught the old cbs.env.example).
                    steps {
                        container('trivy') {
                            sh '''
                                trivy --version
                                trivy fs --scanners secret --exit-code 1 \
                                  --skip-dirs .git --skip-dirs target .
                            '''
                        }
                    }
                }

                stage('Build & Test') {
                    options { timeout(time: 30, unit: 'MINUTES') }
                    steps {
                        container('docker') {
                            // wait for the Docker-in-Docker daemon used by Testcontainers
                            sh 'for i in $(seq 1 30); do docker info >/dev/null 2>&1 && exit 0; sleep 2; done; echo "dind not ready"; exit 1'
                        }
                        sh 'chmod +x mvnw'
                        // compile + unit tests + Testcontainers context test + package JAR
                        sh './mvnw -B -ntp clean verify'
                    }
                    post {
                        always {
                            junit allowEmptyResults: true, testResults: 'target/surefire-reports/*.xml'
                        }
                    }
                }

                stage('Image Build & Push') {
                    when { anyOf { branch 'uat'; branch 'main' } }
                    options { timeout(time: 20, unit: 'MINUTES') }
                    steps {
                        container('docker') {
                            withCredentials([usernamePassword(credentialsId: 'gitlab-registry-push',
                                                              usernameVariable: 'REG_USER',
                                                              passwordVariable: 'REG_PASS')]) {
                                sh '''
                                    set -e
                                    echo "$REG_PASS" | docker login "$REGISTRY" -u "$REG_USER" --password-stdin
                                    docker buildx inspect cbs >/dev/null 2>&1 \
                                      || docker buildx create --name cbs --driver docker-container
                                    docker buildx build --builder cbs \
                                      --platform "$PLATFORMS" \
                                      --label "org.opencontainers.image.revision=$GIT_COMMIT" \
                                      --label "org.opencontainers.image.source=$GIT_URL" \
                                      -t "$IMAGE_NAME:$IMAGE_TAG" \
                                      --push .
                                    docker logout "$REGISTRY"
                                '''
                            }
                        }
                    }
                }

                stage('Trivy Image Gate') {
                    // The image is pushed but NOT deployed unless this passes.
                    // Accepted risks go in .trivyignore (with a reason + review date).
                    when { anyOf { branch 'uat'; branch 'main' } }
                    options { timeout(time: 15, unit: 'MINUTES') }
                    steps {
                        container('trivy') {
                            withCredentials([usernamePassword(credentialsId: 'gitlab-registry-push',
                                                              usernameVariable: 'TRIVY_USERNAME',
                                                              passwordVariable: 'TRIVY_PASSWORD')]) {
                                sh '''
                                    set -e
                                    for p in $(echo "$PLATFORMS" | tr ',' ' '); do
                                      echo "===== Trivy: $IMAGE_NAME:$IMAGE_TAG ($p) ====="
                                      trivy image --image-src remote --platform "$p" \
                                        --scanners vuln --severity "$TRIVY_SEVERITY" --ignore-unfixed \
                                        --exit-code 1 "$IMAGE_NAME:$IMAGE_TAG"
                                    done
                                '''
                            }
                        }
                    }
                }

                stage('Deploy to UAT') {
                    when { branch 'uat' }
                    options { timeout(time: 15, unit: 'MINUTES') }
                    steps {
                        withCredentials([
                            file(credentialsId: 'kubeconfig-cbs-uat', variable: 'KUBECONFIG'),
                            file(credentialsId: 'cbs-uat-env',        variable: 'CBS_ENV_FILE'),
                            usernamePassword(credentialsId: 'gitlab-registry-pull',
                                             usernameVariable: 'REG_PULL_USER', passwordVariable: 'REG_PULL_PASS')
                        ]) {
                            sh '''
                                bash ci/install-kubectl.sh
                                PATH="$WORKSPACE/.tools:$PATH" bash deploy/deploy.sh uat "$IMAGE_NAME:$IMAGE_TAG"
                            '''
                        }
                    }
                }
            }
        }

        // -------------------------------------------------------------
        // SECRETS_ONLY on uat — no build, no approval
        // -------------------------------------------------------------
        stage('UAT: Secrets Only') {
            when {
                beforeAgent true
                allOf { branch 'uat'; expression { params.SECRETS_ONLY } }
            }
            agent { kubernetes { yamlFile 'ci/jenkins-deploy-pod.yaml'; defaultContainer 'tools' } }
            options { timeout(time: 15, unit: 'MINUTES') }
            steps {
                withCredentials([
                    file(credentialsId: 'kubeconfig-cbs-uat', variable: 'KUBECONFIG'),
                    file(credentialsId: 'cbs-uat-env',        variable: 'CBS_ENV_FILE'),
                    usernamePassword(credentialsId: 'gitlab-registry-pull',
                                     usernameVariable: 'REG_PULL_USER', passwordVariable: 'REG_PULL_PASS')
                ]) {
                    sh '''
                        bash ci/install-kubectl.sh
                        PATH="$WORKSPACE/.tools:$PATH" bash deploy/deploy.sh uat --secrets-only
                    '''
                }
            }
        }

        // -------------------------------------------------------------
        // CD to PRODUCTION — main branch only, human approval required
        // -------------------------------------------------------------
        stage('Approval for Production') {
            when { branch 'main' }
            // no agent here on purpose: waiting costs no Pod
            steps {
                timeout(time: 24, unit: 'HOURS') {
                    script {
                        def what = params.SECRETS_ONLY ?
                            'SECRETS ONLY (restart with current image + new cbs-prod-env)' :
                            "${env.IMAGE_NAME}:${env.IMAGE_TAG} (Trivy passed)"
                        env.APPROVED_BY = input(
                            message: "Deploy to PRODUCTION?\n${what}",
                            ok: 'Approve & Deploy',
                            submitter: env.PROD_APPROVERS,        // only these users can approve
                            submitterParameter: 'APPROVER'
                        )
                    }
                    echo "Approved by: ${env.APPROVED_BY}"
                }
            }
        }

        stage('Deploy to Production') {
            when {
                beforeAgent true
                branch 'main'
            }
            agent { kubernetes { yamlFile 'ci/jenkins-deploy-pod.yaml'; defaultContainer 'tools' } }
            options { timeout(time: 45, unit: 'MINUTES') }    // includes the pg_dump backup
            steps {
                withCredentials([
                    file(credentialsId: 'kubeconfig-cbs-prod', variable: 'KUBECONFIG'),
                    file(credentialsId: 'cbs-prod-env',        variable: 'CBS_ENV_FILE'),
                    usernamePassword(credentialsId: 'gitlab-registry-pull',
                                     usernameVariable: 'REG_PULL_USER', passwordVariable: 'REG_PULL_PASS')
                ]) {
                    script {
                        def target = params.SECRETS_ONLY ? '--secrets-only' : "${env.IMAGE_NAME}:${env.IMAGE_TAG}"
                        withEnv(["DEPLOY_TARGET=${target}"]) {
                            // deploy.sh backs up the prod DB first, then deploys, rolls back on failure
                            sh '''
                                bash ci/install-kubectl.sh
                                PATH="$WORKSPACE/.tools:$PATH" bash deploy/deploy.sh prod "$DEPLOY_TARGET"
                            '''
                        }
                    }
                }
            }
        }
    }

    post {
        success {
            echo "SUCCESS: ${env.BRANCH_NAME} ${env.IMAGE_TAG ?: ''}"
        }
        failure {
            echo "FAILED: ${env.BRANCH_NAME} — open the failed stage log to see why (Trivy table, test report, rollout logs)."
        }
        aborted {
            echo "ABORTED: approval rejected or timed out — nothing was deployed to Production."
        }
    }
}
