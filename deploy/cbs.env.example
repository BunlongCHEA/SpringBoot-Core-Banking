# =============================================================
# cbs.env — APPLICATION SECRETS for ONE environment.
#
# This file is a TEMPLATE. The real file is NEVER committed and NEVER
# copied to a server. It lives only inside Jenkins:
#
#   1. cp deploy/cbs.env.example /tmp/cbs-uat.env   (and /tmp/cbs-prod.env)
#   2. fill in real values (UAT and PROD must use DIFFERENT values)
#   3. Jenkins → Manage Jenkins → Credentials → System → Global → Add Credentials
#        Kind: Secret file   ID: cbs-uat-env   (or cbs-prod-env)   File: the file above
#   4. shred -u /tmp/cbs-uat.env
#
# On every deploy Jenkins turns this file into the Kubernetes Secret
# "cbs-env" in namespace cbs-uat / cbs-prod. To CHANGE a password later:
#   edit the credential in Jenkins (upload a new file) → open the branch job
#   → "Build with Parameters" → tick SECRETS_ONLY → Build.
#   (main/prod still needs approval.)
#
# Format: KEY=value, one per line, no spaces around '=', NO quotes
# (quotes would become part of the value). Lines starting with # are ignored.
# Generate random secrets with:  openssl rand -base64 48
# =============================================================

# ---- Which Spring profile: uat  or  prod ----
SPRING_PROFILES_ACTIVE=uat

# ---- PostgreSQL ----
DB_HOST=10.0.10.30
DB_PORT=5432
DB_NAME=core_banking_uat
DB_USERNAME=cbs_app
DB_PASSWORD=CHANGE_ME

# ---- MongoDB ----
MONGO_URI=mongodb+srv://CHANGE_USER:CHANGE_ME@CHANGE_CLUSTER.mongodb.net/core_banking_logs?retryWrites=true&w=majority

# ---- Redis ----
REDIS_URI=redis://default:CHANGE_ME@CHANGE_HOST:6379/0

# ---- Security ----
JWT_SECRET=CHANGE_ME_openssl_rand_base64_48
CBS_SUPER_ADMIN_INITIAL_PASSWORD=CHANGE_ME_min_15_chars
CBS_CORS_ORIGINS=https://cbs-uat.example.com

# ---- KYC integration ----
KYC_BASE_URL=https://kyc.example.com
KYC_API_KEY=CHANGE_ME
# base64 of exactly 32 bytes:  openssl rand -base64 32
KYC_MQ_KEY_V1=CHANGE_ME
CBS_HMAC_SECRET=CHANGE_ME_openssl_rand_base64_48

# ---- RabbitMQ ----
RABBITMQ_ENABLED=false
RABBITMQ_HOST=10.0.10.33
RABBITMQ_PORT=5672
RABBITMQ_USER=cbs_consumer
RABBITMQ_PASS=CHANGE_ME
RABBITMQ_VHOST=kyc_vhost
RABBITMQ_SSL_ENABLED=false
# Production with TLS: RABBITMQ_PORT=5671  RABBITMQ_SSL_ENABLED=true  RABBITMQ_SSL_VERIFY_HOSTNAME=true

# ---- Health check scope ----
# The Kubernetes probes use /actuator/health/liveness and /readiness, which do
# NOT depend on Postgres/Mongo/Redis/RabbitMQ. This flag only affects the full
# /actuator/health page. Keep false until RabbitMQ exists in this environment.
MANAGEMENT_HEALTH_RABBIT_ENABLED=false

# (JAVA_OPTS, replicas, CPU/memory are NOT secrets — they live in
#  deploy/k8s/overlays/<env>/ and are changed through Git.)
