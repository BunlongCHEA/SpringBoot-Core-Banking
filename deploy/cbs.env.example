# =============================================================
# cbs.env — application config + secrets. Template for BOTH environments:
#   cbs-uat.env   → Jenkins credential cbs-uat-env   (namespace cbs-uat)
#   cbs-prod.env  → Jenkins credential cbs-prod-env  (namespace cbs-prod)
#
# This file is committed with NO real secrets. To use it:
#   1. Copy it OUTSIDE the repo, once per env:
#        cp deploy/cbs.env.example ~/cbs-secrets/cbs-uat.env
#        cp deploy/cbs.env.example ~/cbs-secrets/cbs-prod.env
#   2. In each copy change the lines marked "uat → prod" and replace every CHANGE_ME.
#      Database passwords: Terraform-Plan ansible-common/access-info/cbs-data/
#      <db>-access-info.txt  ("Lines for cbs-uat.env" / "Lines for cbs-prod.env").
#      PROD must use DIFFERENT secrets than UAT.
#   3. Jenkins → Manage Jenkins → Credentials → System → Global → Add / Update
#        Kind: Secret file   ID: cbs-uat-env / cbs-prod-env
#   4. Delete the local copies (keep them in your password manager).
# The pipeline refuses to deploy while any CHANGE_ME is left, or if the
# file's SPRING_PROFILES_ACTIVE does not match the environment.
#
# Format: KEY=value, no spaces around '=', no quotes, comments only on their own line.
# Values below are UAT.
# =============================================================

# uat → prod
SPRING_PROFILES_ACTIVE=uat

# ---- PostgreSQL (Terraform-Plan postgres.yml) ----
DB_HOST=postgres.cbs-data.svc.cluster.local
DB_PORT=5432
# uat → prod: core_banking_prod / cbs_prod
DB_NAME=core_banking_uat
DB_USERNAME=cbs_uat
DB_PASSWORD=CHANGE_ME

# ---- MongoDB (mongodb.yml) — replace CHANGE_ME inside the URI ----
# uat → prod: cbs_prod ... /cbs_logs_prod?authSource=cbs_logs_prod
MONGO_URI=mongodb://cbs_uat:CHANGE_ME@mongodb.cbs-data.svc.cluster.local:27017/cbs_logs_uat?authSource=cbs_logs_uat

# ---- Redis (redis.yml) — UAT = DB 1, PROD = DB 0 ----
# uat → prod: redis://cbs_prod:<pw>@redis.cbs-data.svc.cluster.local:6379/0
REDIS_URI=redis://cbs_uat:CHANGE_ME@redis.cbs-data.svc.cluster.local:6379/1

# ---- RabbitMQ (rabbitmq.yml) ----
# Set RABBITMQ_ENABLED=true once Go-KYC publishes to this broker / vhost.
RABBITMQ_ENABLED=false
RABBITMQ_HOST=rabbitmq.cbs-data.svc.cluster.local
RABBITMQ_PORT=5672
# uat → prod: cbs_prod / cbs_prod
RABBITMQ_USER=cbs_uat
RABBITMQ_PASS=CHANGE_ME
RABBITMQ_VHOST=cbs_uat
RABBITMQ_SSL_ENABLED=false
MANAGEMENT_HEALTH_RABBIT_ENABLED=false

# ---- Security ----
# openssl rand -base64 48
JWT_SECRET=CHANGE_ME
# min 15 characters; only used the first time the app starts on an empty database
CBS_SUPER_ADMIN_INITIAL_PASSWORD=CHANGE_ME
# frontend URL(s) allowed to call the API, comma-separated
CBS_CORS_ORIGINS=CHANGE_ME

# ---- KYC integration ----
# Go-KYC base URL
KYC_BASE_URL=CHANGE_ME
# integration API key issued by Go-KYC for CBS
KYC_API_KEY=CHANGE_ME
# openssl rand -base64 32   (must be the same value on the Go-KYC side)
KYC_MQ_KEY_V1=CHANGE_ME
# openssl rand -base64 48
CBS_HMAC_SECRET=CHANGE_ME
