# ---- Health check scope ----
# /actuator/health is DOWN if ANY checked dependency is down, which makes
# deploy.sh roll back. If RabbitMQ (or Mongo) is not installed yet in this
# environment, switch its check off until it is:
MANAGEMENT_HEALTH_RABBIT_ENABLED=false
# MANAGEMENT_HEALTH_MONGO_ENABLED=false

# ---- JVM ----
JAVA_OPTS=-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError
