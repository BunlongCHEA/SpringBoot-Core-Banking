# =============================================================
# /opt/cbs/cbs.env — APPLICATION SECRETS. One per server.
#   sudo chown deploy:deploy /opt/cbs/cbs.env && chmod 600 /opt/cbs/cbs.env
# NEVER commit the real file. UAT and PROD must use DIFFERENT values.
# Format: KEY=value, no spaces around '=', no quotes needed.
# Generate random secrets with:  openssl rand -base64 48
# =============================================================

# ---- Which profile: uat  or  prod ----
SPRING_PROFILES_ACTIVE=uat

# ---- PostgreSQL ----
